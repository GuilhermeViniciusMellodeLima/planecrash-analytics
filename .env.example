# Configuração da API de Large Language Models (LLM)
# Suporta qualquer provedor compatível com a API da OpenAI (OpenAI, Groq, Ollama, DeepSeek, Together, LM Studio, etc.)

# Chave de acesso à API (Obrigatória apenas para a aba 'Análise com IA')
OPENAI_API_KEY=sua_chave_aqui_exemplo_sk_proj_xxxx

# URL base da API (Opcional - padrão é https://api.openai.com/v1)
# Exemplo Groq: https://api.groq.com/openai/v1
# Exemplo Ollama local: http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Modelo padrão a ser utilizado
# Exemplo OpenAI: gpt-4o-mini ou gpt-3.5-turbo
# Exemplo Groq: llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o-mini
